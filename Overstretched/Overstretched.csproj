<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Overstretched</AssemblyName>
    <RootNamespace>Overstretched</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Lethal Company</GameDir>
    <Managed>$(GameDir)\Lethal Company_Data\Managed</Managed>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.Netcode.Runtime.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.Collections.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.UnityWebRequestModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resource names become Overstretched.Assets.Stretched.<file> -->
    <EmbeddedResource Include="Assets\Stretched\*.lpm" />
    <EmbeddedResource Include="Assets\Stretched\*.lpa" />
    <EmbeddedResource Include="Assets\Stretched\*.png" />
  </ItemGroup>

  <!-- The preloader patcher is built first and embedded; Plugin writes it to BepInEx/patchers on startup. -->
  <ItemGroup>
    <ProjectReference Include="..\Overstretched.Preloader\Overstretched.Preloader.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="EmbedPreloader" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <EmbeddedResource Include="..\Overstretched.Preloader\bin\$(Configuration)\netstandard2.1\Overstretched.Preloader.dll"
                        LogicalName="Overstretched.Preloader.dll" />
    </ItemGroup>
  </Target>

  <!-- Build with -p:SkipDeploy=true to leave the game folder alone (e.g. while someone is playing). -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\Overstretched" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\Overstretched" />
  </Target>

</Project>
